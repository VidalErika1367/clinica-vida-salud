APP_NAME="Clínica Vida Salud"
APP_ENV=local
APP_TIMEZONE=America/La_Paz
SESSION_SECURE=false
SESSION_IDLE_MINUTES=30

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clinica_vida_salud
DB_USER=postgres
DB_PASSWORD="ESCRIBE_AQUI_TU_CONTRASENA_DE_POSTGRESQL"
DB_SSLMODE=prefer

# CU27-CU29 (Telegram). Completar solo en .env local o en las variables del servidor.
APP_URL=http://127.0.0.1:8000
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODO=polling
TELEGRAM_WEBHOOK_SECRET=

# CU30: contactos de recepción por WhatsApp. Hasta 3 separados por coma, cada uno "Etiqueta:numero".
# El número lleva código de país y solo dígitos (8 a 15). Ejemplo ficticio de dos contactos:
# CLINICA_RECEPCION_WHATSAPP=Recepción Uno:59170000001,Recepción Dos:59170000002
CLINICA_RECEPCION_WHATSAPP=

# Ubicación del caso de la clínica. Conservar vacía hasta definir la dirección.
CLINICA_DIRECCION=
CLINICA_CIUDAD="Santa Cruz de la Sierra, Bolivia"
# Enlace HTTPS de Google Maps u OpenStreetMap (opcional).
CLINICA_MAPA_URL=
